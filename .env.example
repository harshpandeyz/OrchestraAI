# OrchestraAI — Adaptive Agent Runtime
# Deployment configuration — see README.md for production requirements.
# Copy to .env and fill in. NEVER commit a filled-in .env.
# The runtime resolves RUNTIME_MODE=live only when credentials exist;
# otherwise it runs in explicit, labelled DEMO mode (mock provider).

# --- Server ---
PORT=8787
NODE_ENV=production

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Authentication ---
# Production fails closed: set AUTH_ENABLED=true and provide at least API_TOKEN,
# or use persisted session endpoints. Never commit filled secrets.
AUTH_ENABLED=false
API_TOKEN=
OPERATOR_TOKEN=
READ_TOKEN=

# --- Runtime Mode ---
# live — real provider calls (requires provider credentials)
# demo — deterministic local mock provider, explicitly labelled
# auto — live iff provider key present at startup
RUNTIME_MODE=

# --- Provider Credentials ---
# Supported: openrouter (recommended), openai, anthropic.
# At least one provider key must be set for RUNTIME_MODE=live.
PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_APP_NAME=orchestraai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest

# --- Provider Behavior ---
PROVIDER_TIMEOUT_MS=60000
RUN_TIMEOUT_MS=300000
RUN_MAX_STEPS=12
RUN_MAX_TOOL_CALLS=20
RUN_MAX_RETRIES=2
DEFAULT_BUDGET_USD=0.5
DEFAULT_MAX_CONTEXT_TOKENS=64000
PLATFORM_FEE_PCT=0.25
# Optional Stripe-compatible webhook signing secret. Leave empty to disable.
STRIPE_WEBHOOK_SECRET=

# --- In-Memory Rate Limits (V1 single-process deployment) ---
LIMIT_REQUESTS_PER_MINUTE=300
LIMIT_AUTH_REQUESTS_PER_MINUTE=12

# --- Background Model Discovery / Price Refresh ---
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MS=300000

# --- Sandboxed Workspace for Tools ---
# Empty = project working directory. Tools can never read outside it.
WORKSPACE_ROOT=

# --- Data Directory ---
RUNTIME_DATA_DIR=backend/.runtime-data
# Production durable datastore: the compose deployment sets postgres below.
# Single-node file mode in production requires an explicit opt-in, otherwise
# the server warns loudly (never a silent multi-instance claim).
DATASTORE_PROVIDER=auto
ALLOW_FILE_DATASTORE_IN_PRODUCTION=false
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Redis (distributed locks, rate limits, queue coordination) ---
# Unset = single-process in-memory adapters (dev/test). Production
# multi-instance deployments must set REDIS_URL + QUEUE_PROVIDER=redis.
REDIS_URL=
REDIS_REQUIRED=false
QUEUE_PROVIDER=memory
QUEUE_CONCURRENCY=4

# --- Isolated execution (customer code NEVER runs inside the API process) ---
# Production requires a reachable sandbox-worker for run_tests/build_project;
# without it those tools fail closed (sandbox_unavailable), never locally.
ISOLATED_EXECUTOR_URL=
ISOLATED_EXECUTOR_TOKEN=
SANDBOX_WORKER_TOKEN=
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=8788

# --- Production passwords (no defaults: compose refuses to start without them) ---
POSTGRES_PASSWORD=

# --- Encryption Key ---
# REQUIRED in production. Use a randomly generated 32-byte key as 64 hex
# characters or base64; keep it outside the image and back it up separately
# from RUNTIME_DATA_DIR so stored provider credentials remain recoverable and
# encrypted if the data volume is copied.
DATA_ENCRYPTION_KEY=
# If omitted at runtime, provider credentials cannot be stored encrypted.
# Development may omit this only with NODE_ENV=development; production
# refuses to start without DATA_ENCRYPTION_KEY.

# --- Retention Garbage Collection ---
# Per-run files (events/snapshots/billing) that are neither active nor
# indexed are garbage-collected on this interval. Active/indexed runs
# are never touched. Sweep reports are logged.
RETENTION_SWEEP_INTERVAL_MS=3600000
RETENTION_GRACE_MS=86400000
LOG_LEVEL=info

# --- Rate Limits ---
LIMIT_MAX_CONCURRENT_RUNS=5

# --- Provider & Model ---
# Default provider for runs without explicit provider selection
PREFERRED_PROVIDER=openrouter

# --- Observability ---
# Structured logging level: error|warn|info|debug
STRUCTURED_LOGS=true