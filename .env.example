# Copy to .env and fill in. NEVER commit a filled-in .env.
# The runtime resolves RUNTIME_MODE=live only when credentials exist;
# otherwise it runs in explicit, labelled DEMO mode (mock provider).

PORT=8787
FRONTEND_ORIGIN=http://localhost:5173

# RUNTIME_MODE=live|demo — leave unset for auto (live iff provider key present).
RUNTIME_MODE=

# First provider. Supported: openrouter (recommended), openai, anthropic.
PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_APP_NAME=orchestraai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest

PROVIDER_TIMEOUT_MS=60000
RUN_TIMEOUT_MS=300000
RUN_MAX_STEPS=12
RUN_MAX_TOOL_CALLS=20
RUN_MAX_RETRIES=2
DEFAULT_BUDGET_USD=0.5
DEFAULT_MAX_CONTEXT_TOKENS=64000

# Lightweight background model discovery / price refresh.
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MS=300000

# Sandboxed workspace for the read_file / search_code tools.
# Empty = project working directory. Tools can never read outside it.
WORKSPACE_ROOT=

RUNTIME_DATA_DIR=backend/.runtime-data
LOG_LEVEL=info
