# Provider keys can be configured in-app instead (Settings → Providers):
# keys are verified live, encrypted at rest, and never shown again.
# This file remains for deployment/bootstrap preconfiguration.
# Copy to .env and fill in. NEVER commit a filled-in .env.
# The runtime resolves RUNTIME_MODE=live only when credentials exist;
# otherwise it runs in explicit, labelled DEMO mode (mock provider).

PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# Production fails closed automatically. Set AUTH_ENABLED=true (or
# NODE_ENV=production) and provide at least API_TOKEN, or use the persisted
# email/password session endpoints. Never commit filled secrets.
AUTH_ENABLED=false
API_TOKEN=
OPERATOR_TOKEN=
READ_TOKEN=

# RUNTIME_MODE=live|demo — leave unset for auto (live iff provider key present).
RUNTIME_MODE=

# First provider. Supported: openrouter (recommended), openai, anthropic.
PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_APP_NAME=orchestraai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest

PROVIDER_TIMEOUT_MS=60000
RUN_TIMEOUT_MS=300000
RUN_MAX_STEPS=12
RUN_MAX_TOOL_CALLS=20
RUN_MAX_RETRIES=2
DEFAULT_BUDGET_USD=0.5
DEFAULT_MAX_CONTEXT_TOKENS=64000
# Orchestra fee hypothesis, applied only to positive verified-modeled savings.
PLATFORM_FEE_PCT=0.25
# Optional Stripe-compatible webhook signing secret. Leave empty to disable.
STRIPE_WEBHOOK_SECRET=

# In-memory per-IP guardrails for this single-process V1 deployment.
LIMIT_REQUESTS_PER_MINUTE=300
LIMIT_AUTH_REQUESTS_PER_MINUTE=12

# Lightweight background model discovery / price refresh.
DISCOVERY_ENABLED=true
DISCOVERY_INTERVAL_MS=300000

# Sandboxed workspace for the read_file / search_code tools.
# Empty = project working directory. Tools can never read outside it.
WORKSPACE_ROOT=

RUNTIME_DATA_DIR=backend/.runtime-data
# Required in production. Use a randomly generated 32-byte key as 64 hex
# characters or base64; keep it outside the image and back it up separately
# from RUNTIME_DATA_DIR so stored provider credentials remain recoverable and
# encrypted if the data volume is copied.
DATA_ENCRYPTION_KEY=
# Retention garbage collection for per-run files (events/snapshots/billing)
# that are neither active nor in the retained index. Active/indexed runs are
# never touched. Sweep reports are logged.
RETENTION_SWEEP_INTERVAL_MS=3600000
RETENTION_GRACE_MS=86400000
LOG_LEVEL=info
